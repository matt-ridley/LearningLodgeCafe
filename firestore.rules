rules_version = '2';

// Only the cafe account can read or change the shared list. Everyone else, including
// visitors to the public site, is refused. Paste this into Firestore > Rules and publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cafes/{cafe}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "CAFE_ACCOUNT_UID";
    }
  }
}
